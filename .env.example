# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# Cloudflare R2 (same token as the rclone `r2` remote; see docs/01-server-setup.md E1c)
R2_ENDPOINT_URL=https://0123456789abcdef0123456789abcdef.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=fake-access-key-id
R2_SECRET_ACCESS_KEY=fake-secret-access-key
R2_BUCKET=cloud-ai-lab

# Telegram notifications (lab/notify.py). Token from @BotFather; chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:fake-bot-token
TELEGRAM_CHAT_ID=123456789

# Weights & Biases (lab/tracking.py). Key from wandb.ai/authorize; also stored as the Modal secret `wandb`
WANDB_API_KEY=0000000000000000000000000000000000000000
