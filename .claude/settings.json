{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(modal run:*)",
      "Bash(modal deploy:*)",
      "Bash(modal serve:*)",
      "Bash(rclone delete:*)",
      "Bash(rclone deletefile:*)",
      "Bash(rclone purge:*)",
      "Bash(rclone sync:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(**/.env)",
      "Bash(cat .env:*)"
    ]
  }
}
